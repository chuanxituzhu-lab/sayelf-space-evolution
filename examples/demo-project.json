{
  "project": {
    "name": "线落成墙 Demo",
    "description": "极简住宅客厅，左侧大窗，右侧楼梯，低矮长凳，清水混凝土与暖木材。",
    "ratio": "9:16",
    "duration": "15秒",
    "spaceType": "住宅客厅",
    "style": "建筑手绘 → 写实空间"
  },
  "presentation": {
    "single_frame_ratio": "9:16",
    "sequence_count": "5_or_n",
    "sequence_layout": "horizontal_row",
    "preserve_individual_frames": true
  },
  "input_matching": {
    "source": "space_description",
    "mode": "local_keyword",
    "fields": ["project_name", "space_type", "space_style"],
    "manual_override": true
  },
  "stage_focus": {
    "line": "minimal_large_framework_only_with_stroke_process",
    "linework": "main_structural_skeleton",
    "sketch": "preserve_current_style"
  },
  "client_association": {
    "translate_to": ["visual_focus", "foreground_lead", "scale_reference", "light_rhythm"],
    "viewpoint": "clear_first_look_impact_without_geometry_change"
  },
  "continuity_locks": ["camera","perspective","geometry","openings","anchors"]
}
